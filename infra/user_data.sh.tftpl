#!/bin/bash
# Runs once, on first boot. Installs Docker, the compose plugin and the
# CloudWatch agent, then fetches the deploy files and starts the service.
# Everything here is idempotent so a rerun is harmless.
set -euxo pipefail

dnf -y update
dnf -y install docker amazon-cloudwatch-agent

# The compose plugin is not in the AL2023 repositories: install the release binary.
ARCH=$(uname -m)
COMPOSE_VERSION=v2.40.3
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-$${ARCH}" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

systemctl enable --now docker

# Docker's log driver sends every container's stdout to CloudWatch Logs, which
# is where the JSON check-result lines end up (M4 queries them there).
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{
  "log-driver": "awslogs",
  "log-opts": {
    "awslogs-group": "/sitewatch/containers",
    "awslogs-create-group": "true",
    "awslogs-region": "${region}"
  }
}
JSON
systemctl restart docker

install -d -m 0755 /opt/sitewatch
cat > /opt/sitewatch/env.sh <<'ENV'
export AWS_REGION=${region}
export SITEWATCH_BUCKET=${bucket}
export SITEWATCH_ECR_REPO=${ecr_repo}
export SITEWATCH_DOMAIN=${domain}
export SITEWATCH_ALERT_EMAIL=${alert_email}
ENV

# First deploy: fetch whatever CI has already uploaded. If nothing is there yet
# (the very first apply), this exits quietly and the next deploy does the work.
# The CloudWatch agent is installed above; deploy.sh gives it its configuration.
if aws s3 cp "s3://${bucket}/deploy/deploy.sh" /opt/sitewatch/deploy.sh --region ${region}; then
  chmod +x /opt/sitewatch/deploy.sh
  /opt/sitewatch/deploy.sh || echo "first deploy failed; CI will deploy on the next push"
fi
